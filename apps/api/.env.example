# Corte API — local example values only (contracts/environment.md). Copy to .env.
# Never put real secrets in this file.

# Required. postgresql:// or postgres://
DATABASE_URL=postgresql://corte:corte@localhost:5434/corte_dev

# Required. development | test | staging | production
APP_ENV=development

# Optional. Default 3000
PORT=3000

# Optional. Commit SHA; empty or absent → "unknown"
GIT_SHA=

# Optional. Default false. Forbidden (startup fails) when APP_ENV=production
SWAGGER_ENABLED=true
