# Corte API — local example values only (contracts/environment.md). Copy to .env.
# Never put real secrets in this file.

# Required. postgresql:// or postgres://
DATABASE_URL=postgresql://corte:corte@localhost:5434/corte_dev

# Required. development | test | staging | production
APP_ENV=development

# Optional. Default 3000
PORT=3000

# Optional. Commit SHA; empty or absent → "unknown"
GIT_SHA=

# Optional. Default false. Forbidden (startup fails) when APP_ENV=production
SWAGGER_ENABLED=true

# Required. Signs access tokens; at least 32 characters. Development value only: the API refuses
# to start with this exact value when APP_ENV=production. Generate a real one with
# `openssl rand -base64 48`.
JWT_SECRET=dev-only-change-me-0123456789abcdef

# Optional. Number of trusted reverse-proxy hops for the client IP (X-Forwarded-For). Default 0
TRUST_PROXY=0

# Optional. Default true. false disables the notifications job (every 15 minutes). The API must run
# as a single instance (spec 006 research.md R7).
# JOBS_ENABLED=true

# Optional. Expo access token, only needed if enhanced push security is enabled in Expo. Secret.
# EXPO_ACCESS_TOKEN=
