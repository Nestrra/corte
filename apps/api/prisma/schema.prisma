// Prisma 7 schema (specs 001–005: data-model.md). The connection URL lives in prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// A person with an account. Deleting a user cascades to everything that belongs to them.
model User {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String                 @db.VarChar(80)
  /// Stored trimmed and lowercased (CHECK email = lower(email) added in the migration).
  email              String                 @unique @db.VarChar(254)
  /// argon2id hash in PHC format.
  passwordHash       String                 @map("password_hash")
  timezone           String                 @default("America/Bogota") @db.VarChar(64)
  mustChangePassword Boolean                @default(false) @map("must_change_password")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshTokens      RefreshToken[]
  cards              Card[]
  recurringPayments  RecurringPayment[]
  devices            Device[]
  notifications      Notification[]
  dispatches         NotificationDispatch[]

  @@map("users")
}

/// One issued refresh token. Tokens sharing family_id form one session (one device).
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  /// SHA-256 hex of the opaque token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Keys of cardColors in docs/design-system.md (spec 002, data-model.md → Card.color).
enum CardColor {
  negro
  morado
  amarillo
  naranja
  verde
  marron

  @@map("card_color")
}

/// A credit card of one user (spec 002, data-model.md → Card). Ranges are also enforced by CHECK
/// constraints added by hand in the migration.
model Card {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  name             String      @db.VarChar(40)
  color            CardColor
  last4            String?     @db.Char(4)
  cutoffDay        Int         @map("cutoff_day") @db.SmallInt
  dueDay           Int         @map("due_day") @db.SmallInt
  /// Integer pesos (COP).
  creditLimit      BigInt      @map("credit_limit")
  /// Integer pesos (COP), not greater than credit_limit.
  cycleBudget      BigInt      @map("cycle_budget")
  remindCutoffDays Int         @default(2) @map("remind_cutoff_days") @db.SmallInt
  remindDueDays    Int         @default(3) @map("remind_due_days") @db.SmallInt
  /// Annual effective rate in percent (0–100, 2 decimals); null = no rate (spec 003 FR-006).
  annualRate       Decimal?    @map("annual_rate") @db.Decimal(5, 2)
  /// Null while the card is active.
  archivedAt       DateTime?   @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases        Purchase[]
  statements       Statement[]

  @@index([userId, archivedAt, createdAt])
  @@map("cards")
}

/// A purchase on a card (spec 003, data-model.md → Purchase). Ownership goes through card.user_id.
model Purchase {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId           String        @map("card_id") @db.Uuid
  /// Integer pesos (COP).
  amount           BigInt
  concept          String        @db.VarChar(60)
  purchaseDate     DateTime      @map("purchase_date") @db.Date
  installmentCount Int           @map("installment_count") @db.SmallInt
  noInterest       Boolean       @default(false) @map("no_interest")
  /// Copy of the card's rate when the purchase was registered; never changes afterwards (FR-007).
  annualRate       Decimal?      @map("annual_rate") @db.Decimal(5, 2)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  card             Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  installments     Installment[]

  @@index([cardId, purchaseDate(sort: Desc), createdAt(sort: Desc)])
  @@map("purchases")
}

/// Installment k of a purchase, placed in one statement (data-model.md → Installment).
model Installment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId  String    @map("purchase_id") @db.Uuid
  statementId String    @map("statement_id") @db.Uuid
  number      Int       @db.SmallInt
  /// Principal (abono a capital), integer pesos.
  principal   BigInt
  /// Estimated interest, integer pesos.
  interest    BigInt
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  statement   Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, number])
  @@index([statementId])
  @@map("installments")
}

/// What is paid for one cutoff of a card (data-model.md → Statement). The status is derived.
model Statement {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId       String        @map("card_id") @db.Uuid
  cutoffDate   DateTime      @map("cutoff_date") @db.Date
  dueDate      DateTime      @map("due_date") @db.Date
  /// Business date (the user's "today" when marked paid), not an instant; null while unpaid.
  paidAt       DateTime?     @map("paid_at") @db.Date
  /// The statement total when it was marked paid, integer pesos.
  paidAmount   BigInt?       @map("paid_amount")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  card         Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@unique([cardId, cutoffDate])
  @@map("statements")
}

/// Frequencies of the MVP (spec 005, data-model.md → RecurringPayment.frequency).
enum RecurringFrequency {
  monthly
  annual

  @@map("recurring_frequency")
}

/// A fixed expense that repeats (spec 005, data-model.md → RecurringPayment). Not related to any
/// card. Ranges are also enforced by CHECK constraints added by hand in the migration.
model RecurringPayment {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  name         String                @db.VarChar(40)
  /// Expected amount, integer pesos (COP).
  amount       BigInt
  frequency    RecurringFrequency
  /// First due date when created; never changes (navigation bounds).
  firstDueDate DateTime              @map("first_due_date") @db.Date
  /// Day (and month, if annual) of every due date.
  anchorDate   DateTime              @map("anchor_date") @db.Date
  /// No due date before this one generates an occurrence.
  startsOn     DateTime              @map("starts_on") @db.Date
  /// The user's "today" when paused; null while active.
  pausedOn     DateTime?             @map("paused_on") @db.Date
  /// Days before each due date for its reminder, 0–15 (spec 006 FR-016; CHECK in the migration).
  remindDays   Int                   @default(2) @map("remind_days") @db.SmallInt
  /// Soft delete (research.md R6): paid occurrences keep their payment.
  deletedAt    DateTime?             @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences  RecurringOccurrence[]

  @@index([userId, deletedAt])
  @@map("recurring_payments")
}

/// The due date of a recurring payment in one period (data-model.md → RecurringOccurrence),
/// created on demand when a month is read (research.md R4). The status is derived.
model RecurringOccurrence {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recurringPaymentId String           @map("recurring_payment_id") @db.Uuid
  /// `YYYY-MM` (monthly) or `YYYY` (annual).
  period             String           @db.VarChar(7)
  dueDate            DateTime         @map("due_date") @db.Date
  /// The payment's amount when the occurrence was created, integer pesos.
  expectedAmount     BigInt           @map("expected_amount")
  /// Business date (the user's "today" when marked paid); null while unpaid.
  paidAt             DateTime?        @map("paid_at") @db.Date
  /// Real amount paid, integer pesos.
  paidAmount         BigInt?          @map("paid_amount")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  recurringPayment   RecurringPayment @relation(fields: [recurringPaymentId], references: [id], onDelete: Cascade)

  @@unique([recurringPaymentId, period])
  @@index([recurringPaymentId, dueDate])
  @@map("recurring_occurrences")
}

/// spec 006 data-model.md → Device.platform.
enum DevicePlatform {
  ios
  android

  @@map("device_platform")
}

/// spec 006 data-model.md → NotificationDispatch.kind. `daily_digest` only in dispatches (CHECK).
enum NotificationKind {
  budget_alert
  cutoff_reminder
  payment_reminder
  recurring_reminder
  daily_digest

  @@map("notification_kind")
}

/// A push destination of a user in one session (spec 006 data-model.md → Device). It only
/// receives while its session (refresh-token family) is active.
model Device {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  /// `sid` of the JWT = refresh_tokens.family_id. No FK: sessions have no table.
  sessionId  String         @map("session_id") @db.Uuid
  /// Expo push token; the upsert by token moves it to another user or session.
  token      String         @unique @db.VarChar(255)
  platform   DevicePlatform
  lastSeenAt DateTime       @map("last_seen_at") @db.Timestamptz(6)
  lastTestAt DateTime?      @map("last_test_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("devices")
}

/// An entry of the notifications history (spec 006 data-model.md → Notification), kept 30 days.
model Notification {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  kind       NotificationKind
  title      String                 @db.VarChar(80)
  body       String                 @db.VarChar(300)
  /// card | statement | occurrence (CHECK).
  targetType String                 @map("target_type") @db.VarChar(16)
  /// No FK: what was notified may be archived or deleted (FR-022).
  targetId   String                 @map("target_id") @db.Uuid
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dispatches NotificationDispatch[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// The key that prevents repeating a notice (spec 006 data-model.md → NotificationDispatch). The
/// UNIQUE NULLS NOT DISTINCT key is added by hand in the migration.
model NotificationDispatch {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  kind           NotificationKind
  referenceId    String           @map("reference_id") @db.Uuid
  referenceDate  DateTime         @map("reference_date") @db.Date
  /// 70, 90 or 100 only for budget_alert (CHECK).
  threshold      Int?             @db.SmallInt
  notificationId String?          @map("notification_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification?    @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  /// Created in the migration as UNIQUE NULLS NOT DISTINCT (threshold is null except budget_alert).
  @@unique([userId, kind, referenceId, referenceDate, threshold], map: "notification_dispatches_key")
  @@index([createdAt])
  @@map("notification_dispatches")
}

/// An Expo ticket waiting for its receipt (spec 006 data-model.md → PushTicket).
model PushTicket {
  id        String   @id @db.VarChar(64)
  /// No FK: the device may no longer exist.
  token     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("push_tickets")
}
