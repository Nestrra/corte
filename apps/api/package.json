{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "Corte API (NestJS + Prisma 7 + PostgreSQL 17)",
  "files": [
    "dist"
  ],
  "scripts": {
    "prisma:generate": "prisma generate",
    "predev": "pnpm prisma:generate",
    "dev": "nest start --watch",
    "prebuild": "pnpm prisma:generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "pretypecheck": "pnpm prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm prisma:generate",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "pretest:e2e": "pnpm prisma:generate",
    "test:e2e": "DATABASE_URL=${DATABASE_URL:-postgresql://corte:corte@localhost:5434/corte_test} node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@corte/domain": "workspace:*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "^12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.10",
    "jest": "^30.5.2",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testEnvironment": "node"
  }
}
