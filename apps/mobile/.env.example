# Corte mobile app — copy to .env (contracts/environment.md). Never put secrets here:
# EXPO_PUBLIC_* values are embedded in the app bundle.
#
# iOS simulator:      http://localhost:3000
# Android emulator:   http://10.0.2.2:3000
# Physical device:    http://<your-Mac-IP>:3000  (same Wi-Fi network)
EXPO_PUBLIC_API_URL=http://localhost:3000
